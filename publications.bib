	urldate = {2026-05-20},
	journal = {Movement Disorders},
	author = {Kahl, Fabian and Schalkamp, Ann‐Kathrin and Gunter, Katarina Mary and Ophey, Anja and Röttgen, Sinah and Razzaque, Jamil and Kufer, Konstantin and Sandor, Cynthia and Fink, Gereon R. and Kalbe, Elke and Maetzler, Walter and Hansen, Clint and Jonas, Stephan M. and Hu, Michele T. and Reimer, Lara Marie and Sommerauer, Michael},
	month = may,
	year = {2026},
	pages = {mds.70329},
	file = {Full Text PDF:/Users/laramarie/Zotero/storage/DB5MRCML/Kahl et al. - 2026 - Wearable Movement‐Tracking for Prodromal Parkinson's Disease Detection A Cross‐Country Validation S.pdf:application/pdf},
}

